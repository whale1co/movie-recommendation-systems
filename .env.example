# Backend runtime configuration. Keep real values in the process environment or a local .env file.
# Never commit the local copy or expose these values in screenshots/CI logs.
DB_URL=jdbc:mysql://localhost:3306/movie_rec?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=replace-with-your-local-database-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_SECONDS=604800
JWT_REFRESH_COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900
AI_REQUESTS_PER_MINUTE=10
AI_REQUESTS_PER_DAY=100
MOVIE_POSTER_DIR=./posters
FLYWAY_ENABLED=true

# AI advisor defaults to a deterministic fake client. Use openai-compatible for a real API or Ollama's /v1 endpoint.
LLM_PROVIDER=fake
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TEMPERATURE=0.2
AI_RETRIEVAL_LIMIT=8

# Development-only frontend origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173
